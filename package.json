{
  "name": "@meddleware/vitepress-theme",
  "version": "0.0.1",
  "type": "module",
  "description": "The Meddleware VitePress theme and config: the default theme mapped onto the design tokens (colour mode, seasons, WCAG AAA contrast), a footer, and a shared site config.",
  "license": "0BSD",
  "author": "MeddleWare <dev@meddleware.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/vitepress-theme.git"
  },
  "keywords": [
    "vitepress",
    "theme",
    "design-tokens",
    "accessibility"
  ],
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./src/config.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:site": "vitepress build docs",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "test:e2e": "npm run build:site && playwright test",
    "shots": "SHOTS=1 playwright test"
  },
  "peerDependencies": {
    "@meddleware/design-tokens": "^0.1.12",
    "@meddleware/ui": "^0.1.36",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@meddleware/design-tokens": "^0.1.12",
    "@meddleware/frontend-config": "^0.0.1",
    "@meddleware/ui": "^0.1.36",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "html-validate": "^11.17.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "~5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ],
  "dependencies": {
    "shiki": "^4.4.3"
  }
}
